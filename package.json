{
  "name": "org.mutantcat.ai3d",
  "version": "1.0.20260929",
  "private": true,
  "license": "Apache-2.0",
  "author": "Kelven Ling <kelvenlinglzy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mutantcat-Working-Group/AI3D.git"
  },
  "type": "module",
  "bin": {
    "ai3d": "./cli/ai3d.mjs",
    "ai3d-mcp": "./mcp/server.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "cli/",
    "mcp/",
    "server/",
    "integration/",
    "skills/",
    "dist/",
    "AGENT-INTERFACE.md",
    "README.en.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43175",
    "build": "npm run check:i18n && vite build",
    "prepare": "npm run build",
    "build:integration": "node scripts/build-integration.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build:installer": "tauri build",
    "tauri": "tauri",
    "start": "node server/index.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "sync:docs": "node scripts/sync-reviewer-help.mjs",
    "test": "npm run check:i18n && node --test tests/*.test.mjs",
    "test:browser": "npm run check:i18n && vite build --outDir tmp/refinement-dist && playwright test",
    "test:lan": "node scripts/test-lan.mjs",
    "test:package": "node tests/package-smoke.mjs",
    "samples": "node scripts/generate-samples.mjs",
    "demo": "node scripts/record-demo.mjs",
    "serve:start": "node scripts/service.mjs start",
    "serve:stop": "node scripts/service.mjs stop",
    "serve:status": "node scripts/service.mjs status",
    "format": "prettier --write src server scripts tests integration adapters/openclaw/index.mjs index.html vite.config.js playwright.config.js package.json",
    "format:check": "prettier --check src server scripts tests integration adapters/openclaw/index.mjs index.html vite.config.js playwright.config.js package.json"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "image-size": "^2.0.4",
    "occt-import-js": "^0.0.23",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.12.0",
    "esbuild": "0.28.2",
    "prettier": "^3.9.8",
    "vite": "^7.1.0"
  },
  "description": "Browser-based 3D review and annotation for agent-assisted modeling."
}
