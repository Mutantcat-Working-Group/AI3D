{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI3D",
  "version": "1.3.2",
  "identifier": "org.mutantcat.ai3d",
  "build": {
    "beforeDevCommand": "npm run desktop:build",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../tmp/desktop-package/web"
  },
  "app": {
    "windows": [
      {
        "title": "AI3D",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage"],
    "copyright": "AI3D",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../tmp/desktop-package"],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}

